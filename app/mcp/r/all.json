{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "all",
  "title": "All",
  "description": "Installs every Orchid UI component. all.tsx re-exports Toaster + toast.",
  "registryDependencies": [
    "@orchid/form-builder",
    "@orchid/data-table",
    "@orchid/banner",
    "@orchid/empty",
    "@orchid/file-upload",
    "@orchid/customer-card",
    "@orchid/form-layout",
    "@orchid/page-layout",
    "@orchid/app-layout",
    "@orchid/confirmation-modal",
    "@orchid/resource-picker",
    "@orchid/button",
    "@orchid/button-group",
    "@orchid/dropdown-menu",
    "@orchid/toast",
    "@orchid/badge",
    "@orchid/avatar",
    "@orchid/tooltip",
    "@orchid/tabs",
    "@orchid/choice-card",
    "@orchid/metric-card",
    "@orchid/detail-card",
    "@orchid/data-list",
    "@orchid/copy-button",
    "@orchid/skeleton",
    "@orchid/spinner",
    "@orchid/dialog",
    "@orchid/drawer",
    "@orchid/pagination",
    "@orchid/command",
    "@orchid/popover",
    "@orchid/separator",
    "@orchid/field",
    "@orchid/label",
    "@orchid/input",
    "@orchid/input-group",
    "@orchid/textarea",
    "@orchid/select",
    "@orchid/quantity-input",
    "@orchid/text-editor",
    "@orchid/checkbox",
    "@orchid/radio-group",
    "@orchid/switch",
    "@orchid/slider",
    "@orchid/date-picker",
    "@orchid/form-section"
  ],
  "files": [
    {
      "path": "src/ui/all.tsx",
      "content": "/** Root mount only. `@orchid/all` installs every item via registryDependencies — this file is not a barrel. */\nexport { Toaster, toast } from '@ui/toast'\n",
      "type": "registry:ui",
      "target": "@ui/all.tsx"
    }
  ],
  "type": "registry:ui"
}